# Runs inside the web container behind the server's own reverse proxy (Caddy on
# the host), which terminates HTTPS for the domain and forwards plain HTTP here.
{
	servers {
		# keep the visitor's IP from the host proxy's X-Forwarded-For, so the
		# backend's rate limits apply per visitor rather than to everyone at once
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Same paths the Vite dev server proxies
	@backend path /api/* /uploads/* /c/*
	handle @backend {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}
