# Reference only: the deploy workflow writes DEPLOY_PATH/.env on the server from the
# production environment in GitHub (DOMAIN, ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NAME,
# TIMEZONE). Use this file only to run deploy/docker-compose.yml by hand.
DOMAIN=tapbusiness.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
TIMEZONE=Asia/Jakarta
WEB_PORT=8080
